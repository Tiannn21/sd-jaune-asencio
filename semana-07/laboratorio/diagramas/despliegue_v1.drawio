        <mxCell id="e2" value="TCP 5000&lt;br&gt;ESPERA, LEER ana 1" style="endArrow=block;html=1;strokeColor=#595959;strokeWidth=2;fontSize=11;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="car" target="srv">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="TCP 5000 publicado (5000 → 5000)&lt;br&gt;el mismo protocolo de texto" style="endArrow=block;html=1;strokeColor=#1F4E79;strokeWidth=2;fontSize=11;fontStyle=1;exitX=0;exitY=0.5;entryX=1;entryY=0.4;" edge="1" parent="1" source="otro" target="srv">
          <mxGeometry relative="1" as="geometry"/>

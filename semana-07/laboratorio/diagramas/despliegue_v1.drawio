<mxfile host="app.diagrams.net">
  <diagram name="Despliegue v1" id="sd-semana07-v1-mensajeria">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="host" value="Computador del equipo (anfitrión) — mensajería instantánea, SD-Jaune-Asencio" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#595959;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1080" height="860" as="geometry"/>
        </mxCell>
        <mxCell id="net" value="Red Docker sd_net" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9EA;strokeColor=#C1272D;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;arcSize=3;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1040" height="780" as="geometry"/>
        </mxCell>
        <mxCell id="cli" value="&lt;b&gt;cliente&lt;/b&gt;&lt;br&gt;sd_cliente&lt;br&gt;cliente.py&lt;br&gt;sesión interactiva" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C1272D;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="210" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="car" value="&lt;b&gt;carga&lt;/b&gt;&lt;br&gt;sd_carga&lt;br&gt;cliente_carga.py&lt;br&gt;varios clientes a la vez" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C1272D;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="210" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="proto" value="&lt;b&gt;Protocolo de aplicación v2&lt;/b&gt;&lt;br&gt;no es un contenedor: va dentro del TCP&lt;br&gt;UTF-8, una línea, terminador \n&lt;br&gt;respuesta OK … o ERROR CODIGO …&lt;br&gt;&lt;br&gt;HOLA [nombre] → OK HOLA nombre&lt;br&gt;USUARIOS → OK ana:100 beto:100&lt;br&gt;BANDEJA usuario&lt;br&gt;REGISTRAR usuario&lt;br&gt;ENVIAR origen destino texto&lt;br&gt;LEER usuario cantidad&lt;br&gt;ESPERA segundos&lt;br&gt;SALIR → OK CHAO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0F8;strokeColor=#1F4E79;dashed=1;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="490" width="280" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="srv" value="&lt;b&gt;servidor&lt;/b&gt;&lt;br&gt;sd_servidor&lt;br&gt;servidor.py&lt;br&gt;mensajería instantánea&lt;br&gt;hilo por cliente, timeout 60 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C1272D;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="130" width="280" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="estado" value="Estado compartido, solo en sd_servidor&lt;br&gt;en memoria: si este contenedor cae, se pierde" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#B26A00;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="320" width="530" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="ana" value="&lt;b&gt;ana&lt;/b&gt;&lt;br&gt;usuario inicial&lt;br&gt;100 pendientes&lt;br&gt;buzón vacío []" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B26A00;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="400" width="210" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="beto" value="&lt;b&gt;beto&lt;/b&gt;&lt;br&gt;usuario inicial&lt;br&gt;100 pendientes&lt;br&gt;buzón vacío []" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B26A00;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="400" width="210" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="ops" value="ENVIAR suma 1 pendiente y agrega texto al buzón del destino&lt;br&gt;LEER descuenta pendientes y saca textos (FIFO)&lt;br&gt;REGISTRAR crea un usuario con 0 pendientes&lt;br&gt;BANDEJA y USUARIOS solo leen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B26A00;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="530" width="450" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="lock" value="Un solo Lock&lt;br&gt;ENVIAR y LEER se serializan&lt;br&gt;ESPERA no toma el Lock" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF4E0;strokeColor=#B26A00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="650" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="cont" value="operaciones = 0&lt;br&gt;sube con cada comando&lt;br&gt;del dominio, salvo HOLA y SALIR" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF4E0;strokeColor=#B26A00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="650" width="170" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="otro" value="&lt;b&gt;Otro equipo&lt;/b&gt;&lt;br&gt;su cliente&lt;br&gt;red del laboratorio&lt;br&gt;fuera de este computador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0F8;strokeColor=#1F4E79;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1140" y="160" width="210" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="TCP 5000&lt;br&gt;HOLA, ENVIAR, LEER, SALIR" style="endArrow=block;html=1;strokeColor=#595959;strokeWidth=2;fontSize=11;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.35;" edge="1" parent="1" source="cli" target="srv">
          <mxGeometry relative="1" as="geometry"/>
